# The live server environment. Holds the database password, JWT secret and
# OpenAI key — never commit it. .env.example is the tracked schema.
.env
.env.*
!.env.example

# The flock token deploy.sh holds for the length of a run. Server-local state,
# and it must stay untracked — the "local changes" guard in deploy.sh only
# inspects tracked files, so tracking this would make every deploy skip its
# own `git pull`.
.deploy.lock

*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
