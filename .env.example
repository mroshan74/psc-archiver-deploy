# Server environment template — /opt/psc-archiver/.env
#
# This single file does double duty: Docker Compose reads it for variable
# substitution (${API_TAG}, ${ADMIN_HOST}) AND passes it to the api container as
# its runtime environment.
#
# deploy.sh compares the server's .env key-for-key against this file and
# ABORTS BEFORE TOUCHING ANYTHING if a key is missing. So: whenever you add a
# variable the app needs, add it here in the same change. That check is the
# only thing standing between you and the "why is production behaving
# differently?" afternoon.
#
# Copy to .env, fill in, and `chmod 600 .env`.

# ── Deployment ─────────────────────────────────────────────────────────────
# Two public hostnames, one per frontend. BOTH must already point at this
# server in DNS before the first deploy, or Let's Encrypt cannot issue their
# certificates.
#
# ADMIN_HOST was called APP_HOST until the learner app arrived. If a server's
# .env still has the old name, deploy.sh stops on the env check below — rename
# the key by hand and re-run; nothing is changed until it passes.
# Staff back office — psc-archiver-admin, served by the `web` container.
ADMIN_HOST=archiver.example.com
# Learner-facing app — psc-archiver-client, served by the `learner` container.
LEARNER_HOST=learner.example.com

# Managed by deploy.sh — the currently deployed image tags. Edit only to force
# a specific build; prefer `./scripts/rollback.sh <service> <tag>`.
API_TAG=latest
WEB_TAG=latest
LEARNER_TAG=latest

API_IMAGE=ghcr.io/mroshan74/psc-archiver-api
WEB_IMAGE=ghcr.io/mroshan74/psc-archiver-web
LEARNER_IMAGE=ghcr.io/mroshan74/psc-archiver-client

# ── Required by the API. It refuses to boot without these. ─────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/pscarchiver?retryWrites=true&w=majority
JWT_SECRET=

# ── API runtime ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# The API's CORS allow-list — NOT a hostname for any container. Each frontend
# is same-origin behind its own nginx, so CORS is not exercised by the apps
# themselves; this is the safety net for anything cross-origin.
#
# ⚠ It must name EVERY origin. main.ts splits this on commas and a set
# CLIENT_URL *replaces* the built-in fallback rather than extending it, so
# listing only one host silently drops the other.
CLIENT_URL=https://archiver.example.com,https://learner.example.com

# Overwritten by deploy.sh with the build version. Changing it invalidates
# existing sessions, which is the intended behaviour on deploy.
BUILD_ID=0.0.0

# Swagger is off in production by default. Set to "true" only deliberately.
SWAGGER_ENABLED=false

# ── AI tagging ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=

# The queue worker holds an IN-PROCESS lock. Run exactly one api container
# while this is true — scaling to two would double-process the queue.
AI_TAGGING_QUEUE_ENABLED=true
AI_TAGGING_QUEUE_INTERVAL_MS=60000
AI_TAGGING_SYSTEM_USER_ID=

# Must stay false: this shells out to a desktop file manager.
AI_TAGGING_OPEN_FOLDER_ENABLED=false

# ── Seeding ────────────────────────────────────────────────────────────────
SEEDER_DATA_DIR=data
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
